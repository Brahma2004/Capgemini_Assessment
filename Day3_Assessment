package Day3_Assessment;

import java.time.Duration;
import java.util.List;
import java.util.Random;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;

public class Testcase2 {

	public static void main(String[] args) throws InterruptedException {

		WebDriver driver = new ChromeDriver();

		driver.manage().window().maximize();
		driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(20));

		// 1. Navigate to demo app QSpiders date picker
		driver.get("https://demoapps.qspiders.com/ui/datePick?sublist=0");

		// 2. Click on calendar
		WebElement calendar = driver.findElement(By.xpath("//input"));
		calendar.click();

		// 3. Navigate to the next month in the current year
		WebElement nextMonth = driver.findElement(By.xpath("//button[contains(@class,'react-datepicker__navigation--next')]"));
		nextMonth.click();

		// 4. Select any valid date randomly from that month
		List<WebElement> dates = driver.findElements(By.xpath("//div[contains(@class,'react-datepicker__day') and @role='option' and not(contains(@class,'outside-month'))]"));

		Random random = new Random();
		WebElement date = dates.get(random.nextInt(dates.size()));
		String selectedDate = date.getText();

		System.out.println("Randomly Selected Date: " + selectedDate);

		date.click();

		// 5. Verify that the selected date is displayed correctly in the date field
		String actualDate = calendar.getAttribute("value");

		System.out.println("Displayed Date: " + actualDate);

		if (actualDate != null && !actualDate.isEmpty()) {
			System.out.println("Test Case Passed");
		} else {
			System.out.println("Test Case Failed");
		}

		driver.quit();
	}
}
